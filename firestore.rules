rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Yardımcı Güvenlik Fonksiyonları ───
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aldibasozcan@gmail.com' ||
        request.auth.token.admin == true
      );
    }
    
    // 1. KULLANICI ÖZEL VERİLERİ (Öğretmen / Öğrenci / Panel Verileri)
    // Her kullanıcı YALNIZCA kendi belgesini okuyabilir ve yazabilir.
    // Hiçbir kullanıcı başka bir kullanıcının finans, öğrenci, ders veya ayarlarını göremez!
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // 2. FORUM VE BLOG YAZILARI (public_posts)
    match /public_posts/{postId} {
      // Okuma kuralları:
      // - Onaylanmış yazıları herkes okuyabilir (herkese açık blog/forum).
      // - Yazar kendi bekleyen yazısını görebilir.
      // - Admin tüm yazıları görebilir.
      allow read: if resource.data.status == 'approved' 
                  || (isAuthenticated() && resource.data.authorId == request.auth.uid)
                  || isAdmin();
      
      // Oluşturma kuralları:
      // - Kullanıcı oturum açmış olmalı.
      // - authorId kendi UID'si olmalı (başkası adına yazı oluşturamaz).
      // - Admin değilse status MUTLAKA 'pending' olmalı (kendini doğrudan onaylayamaz).
      allow create: if isAuthenticated() 
                    && request.resource.data.authorId == request.auth.uid
                    && (isAdmin() || request.resource.data.status == 'pending');
      
      // Güncelleme kuralları:
      // - Yazar kendi yazısını güncelleyebilir ancak status'ü doğrudan 'approved' yapamaz.
      // - Admin tüm alanları ve onay durumunu güncelleyebilir.
      allow update: if isAdmin() 
                    || (
                      isAuthenticated() 
                      && resource.data.authorId == request.auth.uid 
                      && request.resource.data.authorId == request.auth.uid
                      && (request.resource.data.status == 'pending' || request.resource.data.status == resource.data.status)
                    );
      
      // Silme kuralları:
      // - Yazar kendi yazısını veya Admin herhangi bir yazıyı silebilir.
      allow delete: if isAdmin() 
                    || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
    
    // 3. DİĞER TÜM KOLEKSİYONLARI VE YOLLARI VARSAYILAN OLARAK ENGELLE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
